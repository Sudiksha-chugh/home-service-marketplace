PORT=8000
NODE_ENV=development

# MongoDB
MONGODB_URI=your_mongodb_atlas_connection_string

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Cloudinary (professional docs & profile images)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Maps / Geocoding (location search)
GOOGLE_MAPS_API_KEY=

# Admin seed credentials (used only to seed the first admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Frontend URLs (for CORS)
CUSTOMER_FRONTEND_URL=http://localhost:5173
PRO_FRONTEND_URL=http://localhost:5174
ADMIN_FRONTEND_URL=http://localhost:5175
ALLOWED_ORIGINS=https://home-service-marketplace-theta.vercel.app
